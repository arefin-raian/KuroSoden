# ─────────────────────────────────────────────────────────────────────────────
# Kuro Sōden (黒送伝) — The Dark Relay Pipeline
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram API (shared across all bots) ────────────────────────────────────
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# ── Pipeline Bot Tokens (create via @BotFather) ──────────────────────────────
# ⚠️ Bot tokens must be the SINGLE <id>:<token> string from @BotFather.
# ⚠️ A duplicated token (the whole string repeated twice) triggers Telegram [400 ACCESS_TOKEN_INVALID].
# Lelouch — Request Bot: handles user requests, dedup, admin assignment
REQUEST_BOT_TOKEN=

# Levi — Downloader Bot: source selection, download, processing, thumbnails
DOWNLOADER_BOT_TOKEN=

# Senku — Distribution Bot: channel creation, content generation, stickers
DISTRIBUTION_BOT_TOKEN=

# Gojo — Publisher Bot: main channel, index, caption review, recovery
PUBLISHER_BOT_TOKEN=

# ── Admin Bot Token (shared — used by nekofetch's admin handlers) ────────────
ADMIN_BOT_TOKEN=

# ── Admin / Owner IDs (comma-separated Telegram user IDs) ────────────────────
ADMIN_IDS=0
OWNER_ID=0

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kuro_soden
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kuro_soden

# ── MongoDB ──────────────────────────────────────────────────────────────────
# On Render + MongoDB Atlas M0, add tlsAllowInvalidCertificates=true to the URI
# and whitelist 0.0.0.0/0 (or Render's IPs) in Atlas → Network Access.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kuro_soden

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=data/storage
SESSION_PATH=data/sessions
# Parallel file-chunk streams for Levi's uploads to the DB channel (0 = default
# 8). Higher saturates a fast uplink; lower it if the host throws FLOOD_WAIT.
UPLOAD_CONCURRENCY=0

# ── Userbot (Telegram USER session — NOT a bot token) ─────────────────────────
# Powers the @acutebot metadata fallback (3rd hop after AniList → Jikan) and any
# userbot-only capability. Generate a StringSession ONCE interactively (phone +
# login code) and paste it below. Leave blank to disable — the metadata chain
# then stops at TMDB and @acutebot is skipped.
#
# Alternatives for multi-account rotation (pick ONE):
#   TELEGRAM_USERBOT_ACCOUNTS      inline JSON: [{"name":"a","session_string":"..."}]
#   TELEGRAM_USERBOT_ACCOUNTS_FILE path to a JSON file with that same array
TELEGRAM_USERBOT_SESSION=

# ── TMDB API ─────────────────────────────────────────────────────────────────
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# ── Jikan (unofficial MAL API) ───────────────────────────────────────────────
# The public API (default below) gateway-times-out (502/504) per-resource under
# load. Two knobs mitigate that:
#
#   JIKAN_SELF_HOST=1  — on a Docker-capable VPS, run.sh auto-deploys a local
#     jikan-rest instance (a ~4-container stack: app + MongoDB + Redis + Typesense
#     via the upstream docker-compose, cloned into tools/jikan-rest). Best-effort:
#     if Docker is absent or slow, the bots still start on the public API.
#
#   JIKAN_FALLBACK_URL — a second Jikan base tried automatically when the primary
#     5xx/times-out. Point it at the local instance so a public 504 fails over
#     instead of degrading. Include /v4, no trailing slash.
#
# JIKAN_BASE_URL is the PRIMARY (tried first). Leave it public and set the
# fallback to local for "public first, local on 504"; or set BASE to local to
# prefer the local instance outright. Empty fallback = primary only.
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_SELF_HOST=0
JIKAN_FALLBACK_URL=

# ── ImgBB (durable image-backup fallback) ────────────────────────────────────
# Free public image host used as the last-resort mirror for backup/restore when
# catbox and telegra.ph both fail. Get a key at https://api.imgbb.com/ (free).
# Leave blank to disable the ImgBB hop — catbox + telegra.ph still run.
IMGBB_API_KEY=

# ── Telegraph (galleries + legacy image host) ────────────────────────────────
# Access token for building Telegraph galleries (the Senku thumbnail picker) and
# as an image-mirror host. Overrides config.yaml thumbnail_channel.telegraph_
# access_token when set. Generate one (no signup) with:
#   curl "https://api.telegra.ph/createAccount?short_name=kuro&author_name=Kuro%20Soden"
# then copy the "access_token" value from the JSON reply. Leave blank to fall
# back to config.yaml, then skip the telegraph host.
TELEGRAPH_ACCESS_TOKEN=

# ── Miruro API (operator-controlled source adapter) ──────────────────────────
# Run https://github.com/walterwhite-69/Miruro-API yourself, then point here.
MIRURO_API_BASE_URL=http://localhost:8000
# Optional referer/origin used for returned streams when the API response does
# not provide per-stream headers.
MIRURO_STREAM_REFERER=http://localhost:8000

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
AUTO_CREATE_SCHEMA=true
