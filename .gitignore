# ── Secrets ──────────────────────────────────────────────────────────────────
.env
# Timestamped .env backups written by scripts/userbot_manager.py — these hold
# live userbot session strings, so they must never be committed.
.env.bak
.env.bak-*
*.session
*.session-journal

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Data ────────────────────────────────────────────────────────────────────
data/
*.session
*.session-journal

# ── Testing ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Vendored third-party downloader (own repo/secrets) — not part of Kuro Soden
Leech-main/

# Auto-installed CLI binaries (aria2c, 7-Zip 7zz/7z.exe) dropped here by the
# launchers — machine-specific, never committed.
tools/

# ── Planning scratch files (local only; not part of the shipped repo) ────────
PLAN.md
PLAN_SENKU.md
PLAN_DOWNLOAD_UX.md
LEVI_PLAN.md

# Local debug/verification media (never commit large mkvs).
# NOTE: the leading '#' is a literal directory name, so it MUST be escaped —
# an unescaped '#issue/' is read as a comment and ignores nothing.
\#issue/
_subs_probe/

# Session continuation logs dumped into the repo root (local scratch).
*this-session-is-being-continued*.txt

# Claude Code local scratch — session history exports and per-machine settings.
history [claude].txt
history*[claude]*.txt
.claude/

# One-off backfill/rollback snapshots (scripts/backfill_idless_request.py)
*.franchise_data.bak.json
